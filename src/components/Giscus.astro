---
interface Props {
  repo?: string;
  repoId?: string;
  category?: string;
  categoryId?: string;
  mapping?: 'pathname' | 'url' | 'title' | 'number';
  theme?: string;
  lang?: string;
  inputPosition?: 'top' | 'bottom';
  reactionsEnabled?: boolean;
}

const {
  repo = 'labsbytir/civontology-notebooks',
  repoId = 'R_kgDOVUOBGQ',
  category = 'General',
  categoryId = 'DIC_kwDOVUOBGc4DJYl6',
  mapping = 'pathname',
  theme = 'preferred_color_scheme',
  lang = 'en',
  inputPosition = 'bottom',
  reactionsEnabled = true,
} = Astro.props;
---

<div class="giscus-container">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={repo}
    data-repo-id={repoId}
    data-category={category}
    data-category-id={categoryId}
    data-mapping={mapping}
    data-strict="0"
    data-reactions-enabled={reactionsEnabled ? '1' : '0'}
    data-emit-metadata="0"
    data-input-position={inputPosition}
    data-theme={theme}
    data-lang={lang}
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</div>

<style>
  .giscus-container {
    margin: 2rem 0;
    min-height: 400px;
  }
</style>
