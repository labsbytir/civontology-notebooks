---
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
---

<!-- Default to black without overriding a reader's saved choice. -->
<script is:inline>
  try {
    if (!localStorage.getItem('starlight-theme')) {
      localStorage.setItem('starlight-theme', 'dark');
    }
  } catch {
    // Storage may be disabled; Starlight still provides its system-theme fallback.
  }
</script>
<ThemeProvider />
